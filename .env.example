# Supabase (AWN-v0 project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App + email
# Local dev default; set to https://awrightnetwork.com in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=AWN <onboarding@resend.dev>

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Native push — Android FCM (server-side)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Native push — iOS APNs (server-side)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=com.awrightworld.awn

# Internal webhook auth for /api/push/dispatch
INTERNAL_API_SECRET=
